DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
# Comma-separated free models (try in order). On 429, rotate to the next; then OPENROUTER_PAID_MODEL if set.
OPENROUTER_FREE_MODELS=
OPENROUTER_PAID_MODEL=
PLAYGROUND_DIR=
SCHEDULE_DISCORD_CHANNEL_ID=
ENABLE_BASH_TOOL=false
# Max wall time per bash_exec child process (ms). Raise for scripts that call slow APIs.
BASH_EXEC_TIMEOUT_MS=120000
